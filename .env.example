# Neon Postgres (values come from the Neon / Vercel integration). Never commit real credentials.

# Recommended for most uses (pooled; used by the app runtime)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# For uses requiring a connection without pgbouncer (used by drizzle-kit)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Parameters for constructing your own connection string
PGHOST=ep-xxx-pooler.region.aws.neon.tech
PGHOST_UNPOOLED=ep-xxx.region.aws.neon.tech
PGUSER=user
PGDATABASE=neondb
PGPASSWORD=password

# Parameters for Vercel Postgres Templates
POSTGRES_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require
POSTGRES_USER=user
POSTGRES_HOST=ep-xxx-pooler.region.aws.neon.tech
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=neondb
POSTGRES_URL_NO_SSL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb
POSTGRES_PRISMA_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?channel_binding=require&connect_timeout=15&sslmode=require

# Auth: HS256 key for API access tokens (JWT), >= 32 chars. `openssl rand -base64 48`
AUTH_JWT_SECRET="replace-with-at-least-32-random-characters"
